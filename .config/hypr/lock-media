#!/bin/sh
# What is playing (the playing player, else the first paused one), for the lock screen: lock-media text | cover | button previous|toggle|next | previous|toggle|next | prepare (writes hyprlock-cover.conf before the lock).

blank="$HOME/.config/hypr/lock-blank.png"   # one clear pixel
cache="${XDG_CACHE_HOME:-$HOME/.cache}/lock-media"
start="$HOME/.config/hypr/hyprlock-cover.conf"
sep=$(printf '\037')   # between the fields; a character no title has

# That player's state, name, title, artist and cover, asked once; title and artist cut to a line, with & and < escaped because hyprlock reads labels as markup.
IFS=$sep read -r state player title artist art <<EOF
$(playerctl -a metadata --format "{{status}}$sep{{playerName}}$sep{{title}}$sep{{artist}}$sep{{mpris:artUrl}}" 2>/dev/null | awk -F"$sep" -v OFS="$sep" '
    function tidy(text) {
        text = substr(text, 1, 60)
        gsub(/&/, "\\&amp;", text); gsub(/</, "\\&lt;", text); gsub(/>/, "\\&gt;", text)
        return text
    }
    { $3 = tidy($3); $4 = tidy($4) }
    $1 == "Playing" { print; found = 1; exit }
    $1 == "Paused" && !paused { paused = $0 }
    END { if (!found && paused) print paused }')
EOF

# The cover's path; one from the web is fetched once and again only when its address changes ($1: how many seconds the fetch may take).
cover() {
    case "$art" in
        file://*)
            path=${art#file://}
            [ -r "$path" ] && echo "$path" || echo "$blank"
            ;;
        http*)
            fetched=""
            [ -s "$cache/cover.jpg" ] && read -r fetched < "$cache/address"
            if [ "$fetched" != "$art" ]; then
                mkdir -p "$cache"
                curl -fsS -m "$1" -o "$cache/cover.jpg.new" "$art" 2>/dev/null &&
                    mv "$cache/cover.jpg.new" "$cache/cover.jpg" && printf '%s' "$art" > "$cache/address" && fetched=$art
            fi
            [ "$fetched" = "$art" ] && echo "$cache/cover.jpg" || echo "$blank"
            ;;
        *) echo "$blank" ;;
    esac
}

case "$1" in
    cover) cover 5 ;;
    # Locking must not wait: the cover is nearly always fetched already, so a second is the most this may take.
    prepare) printf '$cover = %s\n' "$(cover 1)" > "$start" ;;
esac
[ -n "$player" ] || exit 0

case "$1" in
    # The artist smaller and dimmer on its own line (a real line break: hyprlock turns <br/> into one only in its own config).
    text)
        printf '<b>%s</b>' "$title"
        [ -n "$artist" ] && printf '\n<span size="smaller" alpha="70%%">%s</span>' "$artist"
        ;;
    button)
        case "$2" in
            previous) printf "\363\260\222\256" ;;
            next) printf "\363\260\222\255" ;;
            # Pause while it plays, play while it is paused.
            toggle) [ "$state" = Playing ] && printf "\363\260\217\244" || printf "\363\260\220\212" ;;
        esac
        ;;
    previous | next) playerctl -p "$player" "$1" ;;
    toggle) playerctl -p "$player" play-pause ;;
esac
