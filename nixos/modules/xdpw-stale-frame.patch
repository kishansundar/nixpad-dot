From e5ac902e9091fbc6b7d294483a1e7c2820efd57d Mon Sep 17 00:00:00 2001
From: Jihyeon Gim <potatogim@gluesys.com>
Date: Tue, 13 Oct 2026 00:19:19 +0900
Subject: [PATCH] screencast: destroy stale frame before creating a new one

ext_register_frame_cb() calls create_frame() unconditionally. If the
capture is re-armed before the previous frame is completed with a
ready/failed event (e.g. via the PipeWire buffer-starvation retry timer),
the session ends up with two live frame objects, which is a protocol
violation. wlroots-based compositors raise a fatal
"session already has a frame object" error and the portal process dies.

Destroy the stale frame first to make re-arming safe.
---
 src/screencast/ext_image_copy.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/screencast/ext_image_copy.c b/src/screencast/ext_image_copy.c
index afdfcd9c..431bd1d7 100644
--- a/src/screencast/ext_image_copy.c
+++ b/src/screencast/ext_image_copy.c
@@ -294,6 +294,13 @@ static void ext_register_frame_cb(struct xdpw_screencast_instance *cast) {
 			return;
 		}
 	}
+	// A frame object may still be alive if the capture was re-armed before
+	// the previous frame was completed with a ready/failed event. Creating
+	// a second frame on the same session is a protocol violation.
+	if (cast->ext_session.frame) {
+		ext_image_copy_capture_frame_v1_destroy(cast->ext_session.frame);
+		cast->ext_session.frame = NULL;
+	}
 	cast->ext_session.frame = ext_image_copy_capture_session_v1_create_frame(
 			cast->ext_session.capture_session);
 	ext_image_copy_capture_frame_v1_add_listener(cast->ext_session.frame,
