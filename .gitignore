# The working folder of this repo is the whole home folder: everything is ignored except the configs it keeps, so "stage all" can never pick up private files.
/*
!/.gitignore
!/README.md
!/.gitconfig
!/nixos/
/nixos/result*
!/.config/
/.config/*
!/.config/quickshell/
!/.config/mango/
/.config/mango/.wallpaper-new
!/.config/hypr/
!/.config/kitty/
!/.config/matugen/
!/.config/yazi/
!/.config/btop/
!/.config/fastfetch/
!/.config/fish/
!/.config/qimgv/
/.config/qimgv/savedState.conf
!/.config/gtk-3.0/
!/.config/gtk-4.0/
!/.config/xdg-desktop-portal-wlr/
!/.config/nvim/
!/.config/zed/
!/.config/starship.toml
!/.config/mimeapps.list
!/.config/user-dirs.dirs
!/.config/user-dirs.locale
!/.config/zen/
/.config/zen/*
!/.config/zen/6qz5anbx.kishan/
/.config/zen/6qz5anbx.kishan/*
!/.config/zen/6qz5anbx.kishan/user.js
